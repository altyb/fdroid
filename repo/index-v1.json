      "localized": {
        "ar": {
          "description": "\u0644\u0648\u062d\u0629 \u0645\u0641\u0627\u062a\u064a\u062d \u0635\u063a\u064a\u0631\u0629 \u0644\u0623\u0646\u062f\u0631\u0648\u064a\u062f \u0628\u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629. \u0644\u0627 \u062a\u0645\u0644\u0643 \u0625\u0630\u0646 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a\u060c \u0641\u0644\u0627 \u064a\u062e\u0631\u062c \u0645\u0627 \u062a\u0643\u062a\u0628\u0647 \u0645\u0646 \u0647\u0627\u062a\u0641\u0643.\n\n- \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0628\u0627\u0644\u0633\u062d\u0628 \u0628\u0627\u0644\u0644\u063a\u062a\u064a\u0646 \u062f\u0648\u0646 \u0627\u062a\u0635\u0627\u0644\n- \u0627\u0642\u062a\u0631\u0627\u062d \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0648\u062a\u0648\u0642\u0639 \u0627\u0644\u0643\u0644\u0645\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0648\u062a\u0635\u062d\u064a\u062d \u062d\u0630\u0631\u060c \u0648\u0627\u0644\u062a\u0639\u0644\u0645 \u0639\u0644\u0649 \u0627\u0644\u0647\u0627\u062a\u0641 \u0641\u0642\u0637\n- \u0627\u0636\u063a\u0637 \u0645\u0637\u0648\u0644\u0627\u064b \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u0627\u0641\u0629 \u0648\u0627\u0633\u062d\u0628 \u0644\u062a\u062d\u0631\u064a\u0643 \u0627\u0644\u0645\u0624\u0634\u0631\u060c \u0648\u0627\u0633\u062d\u0628 \u0639\u0644\u0649 \u0632\u0631 \u0627\u0644\u062d\u0630\u0641 \u0644\u0645\u0633\u062d \u0643\u0644\u0645\u0627\u062a \u0643\u0627\u0645\u0644\u0629\n- \u0648\u0636\u0639 \u0627\u0644\u064a\u062f \u0627\u0644\u0648\u0627\u062d\u062f\u0629\n- \u0633\u062c\u0644 \u0627\u0644\u062d\u0627\u0641\u0638\u0629 \u0645\u0639 \u0627\u0644\u062a\u062b\u0628\u064a\u062a\n- \u0644\u0648\u062d\u0629 \u0625\u064a\u0645\u0648\u062c\u064a \u0645\u0639 \u0627\u0644\u0628\u062d\u062b \u0628\u0627\u0644\u0627\u0633\u0645 \u0628\u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0623\u0648 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629\n- \u0645\u0641\u0627\u062a\u064a\u062d \u0643\u0644\u0627\u0633\u064a\u0643\u064a\u0629 \u0637\u0648\u064a\u0644\u0629 \u0623\u0648 \u0623\u0644\u0648\u0627\u0646 Material You\n- \u062d\u0642\u0648\u0644 \u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u0631\u0648\u0631: \u0644\u0627 \u062a\u0639\u0644\u0645 \u0648\u0644\u0627 \u0633\u062c\u0644\u060c \u0648\u0645\u062e\u0641\u064a\u0629 \u0639\u0646 \u0644\u0642\u0637\u0627\u062a \u0627\u0644\u0634\u0627\u0634\u0629\n",
          "name": "Hudhud Keyboard",
          "summary": "\u0644\u0648\u062d\u0629 \u0645\u0641\u0627\u062a\u064a\u062d \u062e\u0627\u0635\u0629 \u0644\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 \u0648\u0644\u063a\u0627\u062a \u0623\u062e\u0631\u0649 \u0645\u0639 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0628\u0627\u0644\u0633\u062d\u0628 \u0648\u062f\u0648\u0646 \u0625\u0646\u062a\u0631\u0646\u062a"
